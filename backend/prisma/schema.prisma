// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. 학원(테넌트) & 사용자(인증/권한) 모델
// ==========================================

enum AcademyStatus {
  ACTIVE    // 정상 운영
  SUSPENDED // 일시 정지 (미납/이용제한)
  PENDING   // 승인 대기
}

enum UserRole {
  SUPER_ADMIN // 플랫폼 총괄 슈퍼 관리자
  OWNER       // 원장님 (학원 최고 관리자)
  ADMIN       // 실장/원무 관리자
  TEACHER     // 강사
  STAFF       // 조교/직원
}

model Academy {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(100)
  status         AcademyStatus @default(ACTIVE)
  businessNumber String?       @db.VarChar(20)
  phoneNumber    String?       @db.VarChar(20)
  address        String?       @db.VarChar(255)
  settings       Json?         @db.JsonB // 학원별 알림 설정, 커스텀 옵션 등

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users           User[]
  students        Student[]
  classes         Class[]
  enrollments     Enrollment[]
  attendances     Attendance[]
  tuitionInvoices TuitionInvoice[]
  tuitionPayments TuitionPayment[]
  classLogs       ClassLog[]
  notifications   Notification[]
  academyEvents   AcademyEvent[]
  subscription    Subscription?

  @@index([status])
  @@map("academies")
}

model User {
  id                 Int      @id @default(autoincrement())
  academyId          Int?
  email              String   @unique @db.VarChar(100)
  password           String   @db.VarChar(255)
  name               String   @db.VarChar(50)
  phone              String?  @db.VarChar(20)
  role               UserRole @default(TEACHER)
  hashedRefreshToken String?  @map("hashed_refresh_token") @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy           Academy?         @relation(fields: [academyId], references: [id], onDelete: Cascade)
  taughtClasses     Class[]          @relation("TeacherClasses")
  classLogs         ClassLog[]       @relation("TeacherClassLogs")
  processedPayments TuitionPayment[] @relation("ProcessedPayments")
  auditLogs         AuditLog[]       @relation("AdminAuditLogs")

  @@index([academyId, role])
  @@index([role])
  @@map("users")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  adminId    Int
  action     String   @db.VarChar(100) // 예: "UPDATE_ACADEMY_STATUS", "RESET_USER_PASSWORD", "SUSPEND_ACADEMY", "UPDATE_SUBSCRIPTION_TIER"
  targetType String   @db.VarChar(50)  // 예: "ACADEMY", "USER", "STUDENT", "INVOICE"
  targetId   String?  @db.VarChar(50)
  details    Json?    @db.JsonB
  ipAddress  String?  @db.VarChar(45)

  createdAt DateTime @default(now())

  admin User @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ==========================================
// 2. 학생 & 반 & 수강 관리 모델
// ==========================================

enum StudentStatus {
  ACTIVE     // 재원
  ON_LEAVE   // 휴원
  DISCHARGED // 퇴원
}

enum Gender {
  MALE
  FEMALE
}

model Student {
  id                 Int           @id @default(autoincrement())
  academyId          Int
  name               String        @db.VarChar(50)
  gender             Gender?
  birthDate          DateTime?     @db.Date
  schoolName         String?       @db.VarChar(50)
  grade              String?       @db.VarChar(20) // 예: 초6, 중2, 고1
  studentPhone       String?       @db.VarChar(20)
  parentPhone        String        @db.VarChar(20)
  parentName         String?       @db.VarChar(50)
  parentRelationship String?       @db.VarChar(20) // 예: 모, 부, 조부모
  status             StudentStatus @default(ACTIVE)
  enrolledAt         DateTime?     @db.Date
  dischargedAt       DateTime?     @db.Date
  memo               String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy             Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  enrollments         Enrollment[]
  attendances         Attendance[]
  tuitionInvoices     TuitionInvoice[]
  homeworkSubmissions HomeworkSubmission[]
  notifications       Notification[]

  @@index([academyId, status])
  @@index([academyId, name])
  @@index([academyId, parentPhone])
  @@map("students")
}

enum ClassStatus {
  ACTIVE   // 운영 중
  INACTIVE // 임시 휴강
  CLOSED   // 폐강
}

model Class {
  id          Int         @id @default(autoincrement())
  academyId   Int
  name        String      @db.VarChar(100)
  subject     String?     @db.VarChar(50)
  targetGrade String?     @db.VarChar(20)
  teacherId   Int?
  schedule    String?     @db.VarChar(100) // 예: "월/수/금 17:00-19:00"
  capacity    Int?
  monthlyFee  Decimal     @default(0) @db.Decimal(12, 2)
  status      ClassStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy       Academy        @relation(fields: [academyId], references: [id], onDelete: Cascade)
  teacher       User?          @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments   Enrollment[]
  attendances   Attendance[]
  classLogs     ClassLog[]
  notifications Notification[]

  @@index([academyId, status])
  @@index([academyId, teacherId])
  @@map("classes")
}

enum EnrollmentStatus {
  ENROLLED  // 수강 중
  COMPLETED // 수강 완료 (종강)
  DROPPED   // 중도 하차
  PAUSED    // 수강 일시 정지
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  academyId Int
  studentId Int
  classId   Int
  startDate DateTime         @db.Date
  endDate   DateTime?        @db.Date
  status    EnrollmentStatus @default(ENROLLED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, startDate])
  @@index([academyId, status])
  @@index([classId, status])
  @@index([studentId, status])
  @@map("enrollments")
}

// ==========================================
// 3. 일별 출결 관리 모델
// ==========================================

enum AttendanceStatus {
  PRESENT     // 출석
  ABSENT      // 결석
  LATE        // 지각
  EARLY_LEAVE // 조퇴
}

model Attendance {
  id                BigInt           @id @default(autoincrement())
  academyId         Int
  studentId         Int
  classId           Int
  date              DateTime         @db.Date
  status            AttendanceStatus @default(PRESENT)
  checkInTime       DateTime?
  checkOutTime      DateTime?
  reason            String?          @db.VarChar(255)
  isMakeupNeeded    Boolean          @default(false)
  isMakeupCompleted Boolean          @default(false)
  memo              String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, date])
  @@index([academyId, date])
  @@index([classId, date])
  @@index([studentId, date])
  @@map("attendances")
}

// ==========================================
// 4. 수강료 청구 및 수납 관리 모델
// ==========================================

enum InvoiceStatus {
  UNPAID         // 미납
  PARTIALLY_PAID // 부분 수납
  PAID           // 완납
  VOID           // 취소/무효
}

model TuitionInvoice {
  id               Int           @id @default(autoincrement())
  academyId        Int
  studentId        Int
  billingYearMonth String        @db.VarChar(7) // "YYYY-MM" (예: "2026-09")
  originalAmount   Decimal       @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  finalAmount      Decimal       @db.Decimal(12, 2)
  paidAmount       Decimal       @default(0) @db.Decimal(12, 2)
  status           InvoiceStatus @default(UNPAID)
  dueDate          DateTime      @db.Date
  description      String?       @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy  Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments TuitionPayment[]

  @@index([academyId, billingYearMonth])
  @@index([academyId, status])
  @@index([studentId, billingYearMonth])
  @@map("tuition_invoices")
}

enum PaymentMethod {
  CARD          // 신용/체크카드
  CASH          // 현금
  BANK_TRANSFER // 계좌이체
  EASY_PAY      // 간편결제
  OTHER         // 기타
}

model TuitionPayment {
  id            Int           @id @default(autoincrement())
  academyId     Int
  invoiceId     Int
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CARD)
  paidAt        DateTime      @default(now())
  receiptNumber String?       @db.VarChar(100)
  memo          String?       @db.Text
  processedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy     Academy        @relation(fields: [academyId], references: [id], onDelete: Cascade)
  invoice     TuitionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  processedBy User?          @relation("ProcessedPayments", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([academyId, paidAt])
  @@index([invoiceId])
  @@map("tuition_payments")
}

// ==========================================
// 5. 수업 일지 & 진도 & 과제 모델
// ==========================================

model ClassLog {
  id            Int      @id @default(autoincrement())
  academyId     Int
  classId       Int
  teacherId     Int
  date          DateTime @db.Date
  curriculum    String   @db.VarChar(255) // 교재/진도 범위
  lessonContent String?  @db.Text         // 수업 내용
  homework      String?  @db.Text         // 과제 내용
  notes         String?  @db.Text         // 특이사항

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy             Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  class               Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher             User                 @relation("TeacherClassLogs", fields: [teacherId], references: [id], onDelete: Cascade)
  homeworkSubmissions HomeworkSubmission[]

  @@index([academyId, date])
  @@index([classId, date])
  @@index([teacherId, date])
  @@map("class_logs")
}

enum HomeworkStatus {
  COMPLETED     // 완료
  INCOMPLETE    // 미흡
  NOT_SUBMITTED // 미제출
  EXCUSED       // 면제
}

model HomeworkSubmission {
  id         Int            @id @default(autoincrement())
  classLogId Int
  studentId  Int
  status     HomeworkStatus @default(NOT_SUBMITTED)
  score      Int?
  feedback   String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classLog ClassLog @relation(fields: [classLogId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classLogId, studentId])
  @@index([studentId])
  @@map("homework_submissions")
}

// ==========================================
// 6. 알림 및 카카오톡/SMS 발송 이력 모델
// ==========================================

enum NotificationType {
  UNATTENDED_ALERT   // 미등원 / 지각 경고 알림
  ATTENDANCE_CHECKIN // 등원 완료 알림
  ATTENDANCE_CHECKOUT// 하원 완료 알림
  TUITION_DUE        // 수강료 납부 안내
  SYSTEM_NOTICE      // 시스템 공지
}

enum NotificationChannel {
  IN_APP   // 웹 대시보드 인앱 알림
  KAKAO    // 카카오 알림톡
  SMS      // 대체 문자 메시지
}

enum NotificationStatus {
  SENT     // 발송 완료
  DELIVERED// 수신 확인 / 처리 완료
  FAILED   // 발송 실패
}

model Notification {
  id          Int                 @id @default(autoincrement())
  academyId   Int
  userId      Int?                // 대상 수신자
  studentId   Int?                // 대상 학생
  classId     Int?                // 대상 반
  type        NotificationType    @default(UNATTENDED_ALERT)
  channel     NotificationChannel @default(IN_APP)
  status      NotificationStatus  @default(SENT)
  title       String              @db.VarChar(150)
  message     String              @db.Text
  targetPhone String?             @db.VarChar(20)
  isRead      Boolean             @default(false)
  readAt      DateTime?
  metadata    Json?               @db.JsonB

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  academy     Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student     Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  class       Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([academyId, isRead])
  @@index([academyId, type])
  @@index([academyId, createdAt])
  @@map("notifications")
}

// ==========================================
// 7. 학원 캘린더 이벤트 모델
// ==========================================

enum EventCategory {
  ACADEMY      // 학원 공식 행사 / 설명회
  EXAM         // 정기/모의고사 / 학교 시험대비
  SPECIAL      // 특강 / 보강
  HOLIDAY      // 공휴일 / 정기 휴원
  CONSULTATION // 학부모 상담 주간
  OTHER        // 기타
}

enum EventColor {
  INDIGO
  PURPLE
  ROSE
  AMBER
  EMERALD
  BLUE
  SLATE
}

model AcademyEvent {
  id          Int           @id @default(autoincrement())
  academyId   Int
  title       String        @db.VarChar(150)
  category    EventCategory @default(OTHER)
  color       EventColor    @default(INDIGO)
  startDate   DateTime      @db.Date
  endDate     DateTime?     @db.Date
  startTime   String?       @db.VarChar(5) // "HH:mm"
  endTime     String?       @db.VarChar(5) // "HH:mm"
  description String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@index([academyId, startDate])
  @@index([academyId, category])
  @@map("academy_events")
}

// ==========================================
// 8. 학원 요금제 구독 (플랫폼 자체 수익화) 모델
// ==========================================

enum PlanTier {
  FREE       // 무료 (원생 50명, 1개 학원 제한)
  PRO        // 유료 (무제한 원생/반, 단일 학원)
  ENTERPRISE // 유료 (무제한 + 본원/분원 다중 학원 지원)
}

enum SubscriptionStatus {
  ACTIVE   // 정상 이용 중
  CANCELED // 해지됨 (관리자 수동 처리)
}

model Subscription {
  id        Int                @id @default(autoincrement())
  academyId Int                @unique
  tier      PlanTier           @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  notes     String?            @db.Text // 관리자 메모 (예: "6개월 프로모션 무료 제공")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

