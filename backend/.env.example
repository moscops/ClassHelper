# PostgreSQL Database Connection
# 필수. 값이 없으면 앱이 부팅에 실패합니다(하드코딩된 기본값으로 대체하지 않음).
DATABASE_URL="postgresql://classhelper_user:classhelper_password@localhost:5432/classhelper_db?schema=public"

# App Server Port
PORT=3000

# development | production — production이면 CORS_ORIGIN 필수 & Swagger 문서 비활성화
NODE_ENV=development

# 프로덕션에서 API 요청을 허용할 프론트엔드 도메인 (쉼표로 여러 개 지정 가능).
# 예: CORS_ORIGIN="https://app.classhelper.com,https://admin.classhelper.com"
# 미설정 시 개발 환경(NODE_ENV!=production)에서는 localhost:3000/3001만 허용됩니다.
CORS_ORIGIN=

# JWT Secrets & Expiration — JWT_ACCESS_SECRET/JWT_REFRESH_SECRET은 필수이며,
# 반드시 서로 다른 강력한 랜덤 값으로 설정해야 합니다(예: openssl rand -hex 32).
# 값이 없으면 앱이 부팅에 실패합니다(하드코딩된 기본값으로 대체하지 않음).
JWT_ACCESS_SECRET="super-secret-classhelper-jwt-access-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-classhelper-jwt-refresh-key"
JWT_REFRESH_EXPIRES_IN="7d"
