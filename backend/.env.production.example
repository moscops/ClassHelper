# docker-compose.prod.yml로 배포할 때 backend 컨테이너가 실제로 사용하는 .env 템플릿.
# EC2 서버에서 이 파일을 backend/.env 로 복사한 뒤 실제 값을 채우세요.
# (이 파일 자체와 실제 backend/.env는 절대 git에 커밋하지 않습니다 — .gitignore 확인)

# docker-compose.prod.yml의 postgres 서비스명이 호스트입니다 (localhost 아님!).
# 아래 <DB_PASSWORD>는 저장소 루트의 .env(POSTGRES_PASSWORD)와 반드시 같은 값이어야 합니다.
DATABASE_URL="postgresql://classhelper_user:<DB_PASSWORD>@postgres:5432/classhelper_db?schema=public"

PORT=3000
NODE_ENV=production

# 프론트엔드가 떠 있는 실제 접속 주소(현재는 도메인 없이 EC2 퍼블릭 IP로 접속).
# 예: CORS_ORIGIN="http://<EC2_PUBLIC_IP>:3001"
CORS_ORIGIN=

# openssl rand -hex 32 로 각각 새로 생성 (반드시 서로 다른 값, 절대 아래 예시값 그대로 쓰지 말 것)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN="7d"
